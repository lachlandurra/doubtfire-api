# Rails environment
RAILS_ENV=development

TZ=Australia/Melbourne

# Student work location
DF_STUDENT_WORK_DIR=/student-work

# Overseer (disabled by default)
OVERSEER_ENABLED=0

# Institution settings
DF_INSTITUTION_HOST=http://localhost:3000
DF_INSTITUTION_PRODUCT_NAME=OnTrack

# Database and auth related secrets
DF_SECRET_KEY_BASE=change-me
DF_SECRET_KEY_ATTR=change-me
DF_SECRET_KEY_DEVISE=change-me

# Authentication settings
DF_AUTH_METHOD=database

# Database settings
DF_DEV_DB_ADAPTER=mysql2
DF_DEV_DB_HOST=localhost
DF_DEV_DB_DATABASE=doubtfire-dev
DF_DEV_DB_USERNAME=dfire
DF_DEV_DB_PASSWORD=pwd

# Mail settings
DF_MAIL_DELIVERY_METHOD=smtp
DF_MAIL_PERFORM_DELIVERIES=yes
DF_SMTP_ADDRESS=smtp.gmail.com
DF_SMTP_PORT=587
DF_SMTP_DOMAIN=gmail.com
DF_SMTP_USERNAME=username@gmail.com
DF_SMTP_PASSWORD=change-me
DF_SMTP_AUTH=plain
DF_SMTP_ENABLE_STARTTLS=true

# Magic link settings
DF_MAGIC_LINK_ENABLED=false
DF_MAGIC_LINK_TOKEN_TTL=900
DF_MAGIC_LINK_RESEND_WINDOW=120
DF_MAGIC_LINK_MAX_ATTEMPTS=3
DF_MAGIC_LINK_FROM_EMAIL=username@gmail.com
DF_MAGIC_LINK_SUBJECT=Your OnTrack magic link
DF_MAGIC_LINK_CALLBACK_URL=http://localhost:4200/#/auth/magic-link
DF_MAGIC_LINK_ALLOWED_CALLBACK_HOSTS=localhost:4200
DF_MAGIC_LINK_DEFAULT_REDIRECT_PATH=/sessions/magic-link
DF_MAGIC_LINK_AUTO_PROVISION=false
