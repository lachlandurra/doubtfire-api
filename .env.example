# Doubtfire API environment variables for local OAuth development
# Copy to .env and adjust values for your environment.

# OAuth provider configuration (Prototype A - Google only for now).
DF_OAUTH_PROVIDERS=google
DF_OAUTH_GOOGLE_CLIENT_ID=449344188133-6k9v3mmv5j8iehk2lvljcplgka1rovpf.apps.googleusercontent.com
DF_OAUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
DF_OAUTH_GOOGLE_SCOPE=openid,email,profile
DF_OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
DF_OAUTH_DEFAULT_REDIRECT_URI=http://localhost:4200/sign_in
DF_OAUTH_ALLOWED_REDIRECT_HOSTS=localhost:4200
